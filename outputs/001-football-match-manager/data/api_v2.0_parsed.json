            "mapped_to_template_field": null
        },
        {
            "title": "Match",
            "level": 3,
            "raw_content": "```json\n{\n  \"id\": \"uuid\",\n  \"homeTeam\": {\n    \"id\": \"uuid\",\n    \"name\": \"string\",\n    \"abbreviation\": \"string\",\n    \"crestUrl\": \"url\"\n  },\n  \"awayTeam\": {\n    \"id\": \"uuid\",\n    \"name\": \"string\",\n    \"abbreviation\": \"string\",\n    \"crestUrl\": \"url\"\n  },\n  \"dateTime\": \"ISO string\",\n  \"venue\": \"string\",\n  \"league\": {\n    \"id\": \"uuid\",\n    \"name\": \"string\",\n    \"country\": \"string\"\n  },\n  \"status\": \"upcoming|live|finished|postponed|cancelled\",\n  \"homeScore\": \"integer (nullable)\",\n  \"awayScore\": \"integer (nullable)\",\n  \"lastUpdated\": \"ISO string\"\n}\n```",
            "mapped_to_template_field": null
        },
        {
            "title": "Team",
            "level": 3,
            "raw_content": "```json\n{\n  \"id\": \"uuid\",\n  \"name\": \"string\",\n  \"abbreviation\": \"string\",\n  \"crestUrl\": \"url\",\n  \"foundedYear\": \"integer\"\n}\n```",
            "mapped_to_template_field": null
        },
        {
            "title": "League",
            "level": 3,
            "raw_content": "```json\n{\n  \"id\": \"uuid\",\n  \"name\": \"string\",\n  \"sport\": \"string\",\n  \"country\": \"string\",\n  \"logoUrl\": \"url\",\n  \"currentSeason\": \"string\"\n}\n```",
            "mapped_to_template_field": null
        },
        {
            "title": "User (authenticated user only)",
            "level": 3,
            "raw_content": "```json\n{\n  \"id\": \"uuid\",\n  \"email\": \"string\",\n  \"displayName\": \"string\",\n  \"avatarUrl\": \"url\"\n}\n```",
            "mapped_to_template_field": null
        },
        {
            "title": "Follow Response",
            "level": 3,
