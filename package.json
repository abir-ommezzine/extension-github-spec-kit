{
  "name": "agentdocx-speckit",
  "displayName": "AgentDocx SpecKit",
  "description": "Spec-driven development with AI agents - watch, generate, and evaluate specifications",
  "version": "0.0.2",
  "publisher": "agentdocx",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentdocx-speckit.start_server",
        "title": "Start FastAPI Server"
      },
      {
        "command": "agentdocx-speckit.stopServer",
        "title": "Stop FastAPI Server"
      },
      {
        "command": "agentdocx-speckit.startWatcher",
        "title": "Start Spec Watcher"
      },
      {
        "command": "agentdocx-speckit.stopWatcher",
        "title": "Stop Spec Watcher"
      },
      {
        "command": "agentdocx-speckit.triggerPipeline",
        "title": "Trigger Pipeline"
      }
    ],
    "configuration": {
      "title": "AgentDocx SpecKit",
      "properties": {
        "agentdocx-speckit": {
          "type": "object",
          "description": "Configuration for AgentDocx SpecKit extension",
          "properties": {
            "projectPath": {
              "type": "string",
              "default": "specs",
              "description": "Folder to watch for markdown files (relative to workspace root)"
            },
            "projectName": {
              "type": "string",
              "default": "",
              "description": "Project identifier sent to the pipeline API"
            },
            "apiPort": {
              "type": "number",
              "default": 8000,
              "description": "FastAPI server port"
            },
            "apiHost": {
              "type": "string",
              "default": "127.0.0.1",
              "description": "FastAPI server host"
            },
            "backendPath": {
              "type": "string",
              "default": "backend",
              "description": "Path to backend folder (relative to workspace root or absolute)"
            },
            "reload": {
              "type": "boolean",
              "default": true,
              "description": "Enable uvicorn auto-reload"
            },
            "debounceSeconds": {
              "type": "number",
              "default": 2,
              "description": "Debounce time for file changes before triggering pipeline"
            },
            "watchPatterns": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["**/*.md"],
              "description": "Glob patterns for files to watch"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1"
  }
}