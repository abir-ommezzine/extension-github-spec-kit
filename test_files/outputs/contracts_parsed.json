            "source_section": "Module",
            "attributes": {}
        },
        {
            "type": "entity",
            "identifier": "ENT-ENROLLMENT",
            "content": "Enrollment entity linking a student to a course with progress tracking.",
            "source_section": "Enrollment",
            "attributes": {}
        },
        {
            "type": "functional_requirement",
            "identifier": "FR-REG-USER",
            "content": "Allow students to self-register with email, password, and display name.",
            "source_section": "POST `/api/v1/auth/register`",
            "attributes": {
                "role": "Student"
            }
        },
        {
            "type": "functional_requirement",
            "identifier": "FR-REG-EMAIL",
            "content": "Send a welcome email asynchronously via Resend upon successful registration.",
            "source_section": "POST `/api/v1/auth/register`",
            "attributes": {
                "trigger": "Registration",
                "async": true
            }
        },
        {
            "type": "functional_requirement",
            "identifier": "FR-COURSE-CREATE",
            "content": "Allow instructors to create courses with modules.",
            "source_section": "POST `/api/v1/courses`",
            "attributes": {
                "role": "Instructor"
            }
        },
        {
            "type": "constraint",
            "identifier": "RULE-ACTIVE-ENROLL",
            "content": "ActiveEnrollmentConstraint: A course cannot be deleted if it has active enrollments (returns 409 Conflict).",
            "source_section": "DELETE `/api/v1/courses/{course_id}`",
            "attributes": {
                "error_code": "ACTIVE_ENROLLMENT_CONSTRAINT"
            }
        },
        {
            "type": "functional_requirement",
            "identifier": "FR-ENROLL-VALID",
            "content": "Students can only enroll in published courses and cannot enroll in the same course twice.",
            "source_section": "POST `/api/v1/enrollments`",
            "attributes": {
                "role": "Student"
            }
        },
        {
            "type": "functional_requirement",
            "identifier": "FR-PROGRESS-AUTO",
            "content": "If enrollment progress is updated to 100 and completed_at is null, system must automatically set completed_at to current timestamp.",
            "source_section": "PUT `/api/v1/enrollments/{enrollment_id}`",
            "attributes": {
                "trigger": "progress == 100"
            }
        },
        {
            "type": "constraint",
            "identifier": "RULE-PROGRESS-RANGE",
            "content": "Enrollment progress must be an integer between 0 and 100 inclusive.",
            "source_section": "PUT `/api/v1/enrollments/{enrollment_id}`",
            "attributes": {}
        }
